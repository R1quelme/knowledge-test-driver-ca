{
  "expo": {
    "name": "Drive Test",
    "slug": "driver-quiz-canada",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.matheusriquelme.driverquizcanada"
    },
    "android": {
      "package": "com.matheusriquelme.driverquizcanada",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a2e5a"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "react-native-google-mobile-ads",
        {
          "_comment": "Google's sample App IDs — replace with your own from the AdMob console before shipping. See ADS_SETUP.md.",
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "This lets us show ads that are relevant to you. Drive Test is free because of ads — you can remove them with Premium."
        }
      ]
    ],
    "extra": {
      "_comment": "Test Store keys — replace with the real goog_/appl_ keys before shipping. See PREMIUM_SETUP.md.",
      "revenuecatAndroidKey": "test_jaSETbQLYsxXTHrPzbcsNrjOEOP",
      "revenuecatIosKey": "test_jaSETbQLYsxXTHrPzbcsNrjOEOP"
    }
  }
}
